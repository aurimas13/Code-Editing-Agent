# Copy to .env and fill in. Nothing here is needed to try the project:
# with no API key the server runs in demo mode, and with no Supabase
# settings it keeps data in memory.

# --- Model -------------------------------------------------------------------
# From https://console.anthropic.com. Web research also needs web search
# enabled for the organisation in the Console.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5
# AGENT_DEMO=1            # force the scripted stand-in even if a key is set

# --- Storage -----------------------------------------------------------------
# Project URL and the *secret* key (Settings > API keys). Server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- HTTP --------------------------------------------------------------------
PORT=8080
# Comma-separated. One "*" may stand for part of a host label, for previews.
ALLOWED_ORIGINS=http://localhost:3000
# How to find the visitor's address behind a proxy. Leave both unset locally.
# On Railway: CLIENT_IP_HEADER=X-Real-IP. Behind a proxy that only appends to
# X-Forwarded-For, set TRUSTED_PROXY_HOPS to the number of proxies instead.
CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=0
# Keeps address hashes stable across restarts. Any long random string.
IP_HASH_KEY=

# --- Limits (defaults shown) -----------------------------------------------------
# DAILY_BUDGET_USD=3
# MAX_TURNS_PER_SESSION=12
# TURNS_PER_MINUTE=6
# TURNS_PER_DAY=40
# RESEARCH_PER_DAY=8
# SESSIONS_PER_HOUR=10
# REQUESTS_PER_MINUTE=90
# MAX_ROUNDS=8
# MAX_OUTPUT_TOKENS=1500
# MAX_INPUT_CHARS=2000
# MAX_CONCURRENT_TURNS=8
# RESEARCH_ENABLED=true
